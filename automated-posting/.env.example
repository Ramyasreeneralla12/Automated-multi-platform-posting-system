# Bluesky: handle and an app password (not your main account password)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Mastodon: instance base URL and an access token with write:statuses permission
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Telegram: bot token and destination chat/channel ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack: bot token with chat:write permission and destination channel ID
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Discord: webhook URL for the destination channel
DISCORD_WEBHOOK_URL=
